{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "Simple web-based expense tracker with persistent storage",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore data/ --ignore .git/ --ignore '*.db' --ignore '*.db-wal' --ignore '*.db-shm' server.js",
    "test": "DB_PATH=./data/test-expenses.db node --test tests/api.test.js",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^9.0.0",
    "express": "^4.18.0",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "nodemon": "^3.0.0"
  }
}
